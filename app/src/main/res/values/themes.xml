<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DocExpiryTracker" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorPrimaryVariant">#1D4ED8</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#2563EB</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">#F8F9FC</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#111827</item>
        <item name="android:statusBarColor">#F8F9FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F8F9FC</item>
        <item name="materialAlertDialogTheme">@style/DialogTheme</item>
        <!-- MaterialDatePicker uses colorPrimary from app theme automatically -->
    </style>

    <style name="DialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">#FFFFFF</item>
        <item name="colorPrimary">#2563EB</item>
        <item name="android:textColor">#111827</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveBtn</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeBtn</item>
    </style>

    <style name="PositiveBtn" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#2563EB</item>
    </style>

    <style name="NegativeBtn" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#9CA3AF</item>
    </style>

    <style name="FullscreenDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">#F8F9FC</item>
        <item name="colorPrimary">#2563EB</item>
        <item name="android:textColor">#111827</item>
        <item name="buttonBarPositiveButtonStyle">@style/PositiveBtn</item>
    </style>

    <style name="BottomSheetTheme" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:background">#00000000</item>
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet">
        <item name="android:background">#00000000</item>
    </style>

</resources>
