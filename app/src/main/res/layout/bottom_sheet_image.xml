<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="#E5E7EB"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Document Image"
        android:textColor="#111827"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:id="@+id/btn_gallery"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_sheet_btn"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🖼️" android:textSize="20sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  Choose from Gallery"
            android:textColor="#111827" android:textSize="15sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_camera"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_sheet_btn"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📷" android:textSize="20sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  Take a Photo"
            android:textColor="#111827" android:textSize="15sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_pdf"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_sheet_btn"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📄" android:textSize="20sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  Upload PDF"
            android:textColor="#111827" android:textSize="15sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_view_image"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_sheet_btn"
        android:padding="16dp"
        android:layout_marginBottom="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="👁️" android:textSize="20sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  View Full Image"
            android:textColor="#111827" android:textSize="15sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_remove_image"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_sheet_btn_danger"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🗑️" android:textSize="20sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="  Remove Image"
            android:textColor="#FF3C60" android:textSize="15sp"/>
    </LinearLayout>

</LinearLayout>
