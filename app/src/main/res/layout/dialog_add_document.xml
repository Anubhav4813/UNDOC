<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#FFFFFF">

    <!-- Document Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Document Name"
        app:boxBackgroundColor="#F9FAFB"
        app:boxStrokeColor="#2563EB"
        app:hintTextColor="#9CA3AF"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_doc_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:inputType="textCapWords"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Category -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Category"
        app:boxBackgroundColor="#F9FAFB"
        app:boxStrokeColor="#2563EB"
        app:hintTextColor="#9CA3AF"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <AutoCompleteTextView
            android:id="@+id/ac_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Issue Date — hint ONLY on layout, no hint on EditText -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Issue Date"
        app:boxBackgroundColor="#F9FAFB"
        app:boxStrokeColor="#2563EB"
        app:hintTextColor="#9CA3AF"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_issue_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Expiry Date — hint ONLY on layout, no hint on EditText -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Expiry Date"
        app:boxBackgroundColor="#F9FAFB"
        app:boxStrokeColor="#2563EB"
        app:hintTextColor="#9CA3AF"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_expiry_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111827"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="📸  You can add a document photo after saving"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:paddingBottom="4dp"/>

</LinearLayout>
