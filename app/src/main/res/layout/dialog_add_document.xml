<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp"
    android:background="#FFFFFF">

    <!-- Document Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Document Name"
        style="@style/InputField">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_doc_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:inputType="textCapWords"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Category -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Category"
        style="@style/InputFieldDropdown">
        <AutoCompleteTextView
            android:id="@+id/ac_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Vehicle No. / Owner Tag (optional) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Vehicle No. / Owner (optional)"
        style="@style/InputField">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_doc_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:inputType="textCapCharacters"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Issue Date -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Issue Date"
        style="@style/InputField">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_issue_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Expiry Date -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="Expiry Date"
        style="@style/InputField">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_expiry_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Hint text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📸"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  You can add a document photo after saving"
            android:textColor="#94A3B8"
            android:textSize="12sp"/>
    </LinearLayout>

</LinearLayout>
